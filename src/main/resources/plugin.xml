<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
    <extension
            point="com.polarion.portal.tomcat.webapps">
        <webapp
                name="polarion/docx-exporter"
                contextRoot="webapp/docx-exporter">
        </webapp>
    </extension>

    <!-- The React administration app. Serves the Vite bundle, the build-generated help articles and the
         administration menu icons - every administration page of this extension comes from here. -->
    <extension
            point="com.polarion.portal.tomcat.webapps">
        <webapp
                name="polarion/docx-exporter-app"
                contextRoot="webapp/docx-exporter-app">
        </webapp>
    </extension>
</plugin>
